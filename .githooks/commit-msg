#!/bin/sh

# commit-msg hook: 检查 commit message 是否符合 Conventional Commits 格式

commit_msg=$(cat "$1")

# 允许的类型
types="feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert"

# 匹配格式: type(scope?): message
if ! echo "$commit_msg" | grep -qE "^\s*($types)(\(.+\))?: .+"; then
    echo ""
    echo "❌ 不合法的 commit message 格式！"
    echo ""
    echo "   格式: <type>: <简短描述>"
    echo ""
    echo "   合法 type: feat / fix / docs / style / refactor / test / chore / perf / ci / build / revert"
    echo ""
    echo "   示例:"
    echo "     feat: 添加 PDF 文档上传功能"
    echo "     fix: 修复中文文件名乱码"
    echo "     docs: 更新 README 安装说明"
    echo "     refactor: 抽取 LLM 调用为独立 Service"
    echo ""
    echo "   多行格式（第一行标题后空一行写正文）:"
    echo "     feat: 添加 PDF 文档上传功能"
    echo ""
    echo "     原有的上传只支持 TXT，但用户文档主要是 PDF 格式。"
    echo "     使用 PyMuPDF 读取 PDF 内容并转为纯文本后做向量化。"
    echo ""
    exit 1
fi
